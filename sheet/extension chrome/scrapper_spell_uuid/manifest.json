{
  "manifest_version": 3,
  "name": "scrapper_spell_uuid",
  "version": "1.0.0",
  "description": "Scrape Pathfinder 2e spell UUIDs from pf2e.pathfinder-fr.org",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://pf2e.pathfinder-fr.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://pf2e.pathfinder-fr.org/spells*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
